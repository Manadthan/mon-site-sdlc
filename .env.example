# Copier ce fichier en .env.local et remplir les valeurs (ne jamais committer .env.local).

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé serveur uniquement (import des images) — jamais exposée au navigateur
SUPABASE_SERVICE_ROLE_KEY=

# Nom du bucket Storage pour les images
SUPABASE_IMAGES_BUCKET=items
