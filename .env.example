# Copier ce fichier en .env.local et remplir les valeurs (ne jamais committer .env.local).
# En ligne, ces variables sont réglées dans Vercel → Settings → Environment Variables.

# Supabase — Project Settings > API Keys. Valeurs publiques : la sécurité repose sur la RLS.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Tests e2e uniquement, base locale (npx supabase status) : jamais la clé de production.
# E2E_SUPABASE_SECRET_KEY=

# --- Étape 6 (import des images), pas encore utilisé ---
# Clé secrète, serveur uniquement, jamais exposée au navigateur.
# SUPABASE_SECRET_KEY=
# Nom du bucket Storage pour les images
# SUPABASE_IMAGES_BUCKET=items
